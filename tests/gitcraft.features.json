{
 "_how": "Steps: {press: 'Space'}, {hold: 'ArrowRight', ms: 500}, {tap: [x, y]}, {wait: 300}, {assert: '<js>', name: '...'}.",
 "features": [
  {
   "name": "the opening plays once, and can be skipped",
   "requirement": "short atmospheric opening, skippable immediately",
   "steps": [
    {
     "assert": "window.__game.state === 'title'",
     "name": "starts on the title"
    },
    {
     "press": "Enter"
    },
    {
     "wait": 400
    },
    {
     "assert": "window.__game.state === 'opening'",
     "name": "a first visit opens on the bedroom at 11:41 PM"
    },
    {
     "press": "Escape"
    },
    {
     "wait": 300
    },
    {
     "assert": "window.__game.state === 'playing' && window.__game.night === 1",
     "name": "skipping lands in night 1"
    }
   ]
  },
  {
   "name": "the first bite is by hand",
   "requirement": "first manual blood extraction",
   "steps": [
    {
     "press": "Enter"
    },
    {
     "wait": 300
    },
    {
     "press": "Escape"
    },
    {
     "wait": 300
    },
    {
     "assert": "window.__game.buildings === 0 && window.__game.workers === 0",
     "name": "no prebuilt infrastructure, no staff"
    },
    {
     "hold": "b",
     "ms": 2600
    },
    {
     "wait": 1600
    },
    {
     "assert": "window.__game.score > 0 && window.__game.bank > 0",
     "name": "holding bites, letting go brings the blood home"
    }
   ]
  },
  {
   "name": "storage is the first building, placed by the player",
   "requirement": "buildings emerge from needs; player-selected placement",
   "steps": [
    {
     "press": "Enter"
    },
    {
     "wait": 300
    },
    {
     "press": "Escape"
    },
    {
     "wait": 300
    },
    {
     "assert": "!window.__game.unlocked.includes('tank')",
     "name": "no build cards until something is needed"
    },
    {
     "assert": "(window.__game.debug.bank(30), true)",
     "name": "fill the bottle cap"
    },
    {
     "wait": 300
    },
    {
     "assert": "window.__game.unlocked.includes('tank')",
     "name": "a full cap unlocks the storage tank"
    },
    {
     "press": "1"
    },
    {
     "wait": 200
    },
    {
     "assert": "window.__game.placing === 'tank'",
     "name": "the card asks where"
    },
    {
     "assert": "(window.__game.debug.placeBest(), true)",
     "name": "place it"
    },
    {
     "wait": 300
    },
    {
     "assert": "window.__game.buildings === 1 && window.__game.placing === null",
     "name": "the tank is built where it was placed"
    }
   ]
  },
  {
   "name": "pause stops the clock",
   "requirement": "pause",
   "steps": [
    {
     "press": "Enter"
    },
    {
     "wait": 300
    },
    {
     "press": "Escape"
    },
    {
     "wait": 300
    },
    {
     "press": "p"
    },
    {
     "wait": 200
    },
    {
     "assert": "window.__game.paused === true",
     "name": "P pauses"
    },
    {
     "press": "Escape"
    },
    {
     "wait": 200
    },
    {
     "assert": "window.__game.paused === false",
     "name": "Escape resumes"
    }
   ]
  },
  {
   "name": "the night ends in a morning, and the colony carries over",
   "requirement": "finite nights; persistent colony",
   "steps": [
    {
     "press": "Enter"
    },
    {
     "wait": 300
    },
    {
     "press": "Escape"
    },
    {
     "wait": 300
    },
    {
     "assert": "(window.__game.debug.preset('mid'), window.__game.debug.trigger('wake'), true)",
     "name": "alarm"
    },
    {
     "wait": 4200
    },
    {
     "assert": "window.__game.state === 'over' && !document.getElementById('review').hidden",
     "name": "the morning sheet is shown"
    },
    {
     "assert": "(document.getElementById('again').click(), true)",
     "name": "night 2"
    },
    {
     "wait": 400
    },
    {
     "assert": "window.__game.night === 2 && window.__game.buildings >= 5 && window.__game.workers >= 6",
     "name": "night 2 starts with last night's colony"
    }
   ]
  }
 ]
}
