{
 "version": 1,
 "product": "game",
 "viewports": [
  "phone",
  "desktop"
 ],
 "shots": [
  {
   "id": "title",
   "name": "Title, fully loaded",
   "kind": "title",
   "steps": [],
   "wait_for": {
    "selector": "#title[data-ready]",
    "timeout_ms": 8000
   }
  },
  {
   "id": "opening",
   "name": "The opening: 11:42 PM",
   "kind": "moment",
   "moment": "opening",
   "steps": [
    {
     "selector": "#clock-in"
    }
   ],
   "sequence": {
    "after_ms": 5500
   },
   "wait_for": {
    "js": "window.__game.state === 'opening' && window.__game.cine > 5",
    "timeout_ms": 12000
   }
  },
  {
   "id": "first-seconds",
   "name": "First seconds of night 1",
   "kind": "play",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    }
   ],
   "wait_for": {
    "js": "window.__game.state === 'playing' && window.__game.time > 2",
    "timeout_ms": 8000
   }
  },
  {
   "id": "first-bite",
   "name": "Rhonda drinking",
   "kind": "moment",
   "moment": "first-bite",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.hold(true)"
    }
   ],
   "wait_for": {
    "js": "window.__game.founder === 'drink' && window.__game.belly > 2",
    "timeout_ms": 8000
   }
  },
  {
   "id": "mid-play",
   "name": "A small colony running",
   "kind": "play",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.preset('mid')"
    }
   ],
   "wait_for": {
    "js": "window.__game.state === 'playing' && window.__game.workers >= 6 && window.__game.buildings >= 5",
    "timeout_ms": 8000
   }
  },
  {
   "id": "the-swat",
   "name": "The swat lands",
   "kind": "moment",
   "moment": "the-swat",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.preset('mid')"
    },
    {
     "eval": "window.__game.debug.trigger('swat')"
    }
   ],
   "sequence": {
    "before": {
     "js": "window.__game.fx === 'swat-warning'"
    },
    "after_ms": 900
   },
   "wait_for": {
    "js": "window.__game.fx === 'swat-impact'",
    "timeout_ms": 8000
   }
  },
  {
   "id": "wake-up",
   "name": "The alarm: the sleeper wakes",
   "kind": "fail",
   "moment": "wake-up",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.preset('mid')"
    },
    {
     "eval": "window.__game.debug.trigger('wake')"
    }
   ],
   "sequence": {
    "after_ms": 1200
   },
   "wait_for": {
    "js": "window.__game.state === 'waking'",
    "timeout_ms": 8000
   }
  },
  {
   "id": "morning",
   "name": "The first morning",
   "kind": "results",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.preset('mid')"
    },
    {
     "eval": "window.__game.debug.trigger('wake')"
    }
   ],
   "wait_for": {
    "selector": "#review[data-ready]",
    "timeout_ms": 15000
   }
  },
  {
   "id": "day",
   "name": "A day: he is at work",
   "kind": "screen",
   "steps": [
    {
     "selector": "#clock-in"
    },
    {
     "selector": "#skip"
    },
    {
     "eval": "window.__game.debug.preset('mid')"
    },
    {
     "eval": "window.__game.debug.trigger('wake')"
    },
    {
     "selector": "#again"
    }
   ],
   "wait_for": {
    "js": "window.__game.phase === 'day'",
    "timeout_ms": 15000
   }
  },
  {
   "id": "handbook",
   "name": "Employee handbook",
   "kind": "screen",
   "steps": [
    {
     "selector": "#open-handbook"
    }
   ],
   "wait_for": {
    "selector": "#handbook[data-open]",
    "timeout_ms": 8000
   }
  }
 ]
}
